{
  "mcpServers": {
    "jira": {
      "command": "cmd",
      "args": ["/c", "agentsecrets", "env", "--", "mcp-atlassian"]
    },
    "qase": {
      "command": "cmd",
      "args": ["/c", "agentsecrets", "env", "--", "qase-mcp-server"]
    },
    "playwright": {
      "command": "cmd",
      "args": ["/c", "playwright-mcp", "--output-dir", "agentic-workflows/playwright-output"]
    },
    "glitchtip": {
      "command": "cmd",
      "args": ["/c", "agentsecrets", "env", "--", "mcp-glitchtip"],
      "env": {
        "GLITCHTIP_ORGANIZATION": "foodme",
        "GLITCHTIP_BASE_URL": "https://app.glitchtip.com"
      }
    },
    "grafana": {
      "type": "http",
      "url": "https://foodme-monitoring.onrender.com/mcp"
    }
  }
}
